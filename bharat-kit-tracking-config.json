        "monthly": {
          "inventoryAudit": true,
          "vendorPerformance": true,
          "budgetUtilization": true,
          "wasteReport": true,
          "recipients": ["study-coordinator@longevityindia.org", "finance@longevityindia.org"]
        }
      },
      "dashboards": {
        "realTimeInventory": {
          "url": "/bharat-inventory-dashboard.html",
          "refreshInterval": "5_minutes",
          "widgets": ["stock_levels", "expiry_calendar", "temperature_monitoring", "usage_trends"]
        },
        "procurementDashboard": {
          "url": "/bharat-procurement-dashboard.html", 
          "refreshInterval": "1_hour",
