    "inventoryTracking": {
      "batchTracking": {
        "enabled": true,
        "batchNumberFormat": "YYYY-MM-DD-{sequence}",
        "lotNumberTracking": true,
        "expiryDateTracking": true,
        "temperatureLogging": true
      },
      "consumption": {
        "trackUsage": true,
        "usageReporting": "weekly",
        "forecastDemand": true,
        "seasonalAdjustments": true
      },
      "qualityControl": {
        "receiptInspection": true,
        "storageConditionMonitoring": true,
        "periodicInventoryAudits": "monthly",
        "damageTracking": true
      }
    },
    
    "alertSystem": {
      "expiryAlerts": {
        "criticalAlert": {
          "threshold": 7,
          "severity": "critical",
          "recipients": ["lab-manager@longevityindia.org", "procurement@longevityindia.org"],
          "message": "CRITICAL: {item_name} expires in {days_remaining} days. Immediate action required."
        },
        "warningAlert": {
          "threshold": 30,
          "severity": "warning", 
          "recipients": ["lab-manager@longevityindia.org"],
          "message": "WARNING: {item_name} expires in {days_remaining} days. Plan replacement."
        },
        "informationalAlert": {
          "threshold": 90,
          "severity": "info",
          "recipients": ["procurement@longevityindia.org"],
          "message": "INFO: {item_name} expires in {days_remaining} days. Consider reordering."
        }
      },
      "stockAlerts": {
        "lowStockAlert": {
          "triggerPercentage": 20,
          "severity": "warning",
          "recipients": ["lab-manager@longevityindia.org", "procurement@longevityindia.org"],
          "message": "LOW STOCK: {item_name} is below minimum threshold. Current: {current_stock}, Minimum: {minimum_stock}"
        },
        "outOfStockAlert": {
          "triggerQuantity": 0,
          "severity": "critical",
          "recipients": ["lab-manager@longevityindia.org", "procurement@longevityindia.org", "study-coordinator@longevityindia.org"],
          "message": "OUT OF STOCK: {item_name} is completely depleted. Operations may be affected."
        }
      },
      "temperatureAlerts": {
        "temperatureDeviationAlert": {
          "tolerance": 2,
          "severity": "warning",
          "recipients": ["lab-manager@longevityindia.org"],
          "message": "TEMPERATURE ALERT: {storage_unit} temperature outside acceptable range. Current: {current_temp}°C, Target: {target_temp}°C"
        },
        "powerFailureAlert": {
          "severity": "critical",
          "recipients": ["lab-manager@longevityindia.org", "facility-manager@longevityindia.org"],
          "message": "POWER FAILURE: {storage_unit} power supply interrupted. Immediate intervention required."
        }
      }
    },
    
