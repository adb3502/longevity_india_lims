    "validationRules": {
      "ageValidation": {
        "minAge": 20,
        "maxAge": 70,
        "description": "Participants must be between 20-70 years for BHARAT Study"
      },
      "phoneValidation": {
        "pattern": "^[6-9][0-9]{9}$",
        "description": "Valid Indian mobile number"
      },
      "pinCodeValidation": {
        "pattern": "^[1-9][0-9]{5}$",
        "description": "Valid Indian PIN code"
      },
      "cohortAssignment": {
        "AG1": {"minAge": 20, "maxAge": 30},
        "AG2": {"minAge": 31, "maxAge": 40},
        "AG3": {"minAge": 41, "maxAge": 50},
        "AG4": {"minAge": 51, "maxAge": 60},
        "AG5": {"minAge": 61, "maxAge": 70}
      }
    },
    
    "dataPrivacy": {
      "sensitiveFields": [
        "religion",
        "caste",
        "monthlyIncome",
        "primaryPhone",
        "alternatePhone",
        "emailAddress"
      ],
      "optionalFields": [
        "middleName",
        "localName",
        "religion",
        "caste",
        "yearsInCurrentLocation",
        "alternatePhone",
        "emailAddress",
        "medications"
      ],
      "encryptionRequired": [
        "primaryPhone",
        "alternatePhone",
        "emailAddress",
        "pinCode"
      ]
    },
    
    "reportingCategories": {
      "demographic": [
        "age",
        "gender",
        "birthState",
        "currentState",
        "residenceType"
      ],
      "socioeconomic": [
        "education",
        "occupation",
        "monthlyIncome",
        "healthInsurance"
      ],
      "cultural": [
        "religion",
        "motherTongue",
        "dietaryPattern"
      ],
      "lifestyle": [
        "smokingStatus",
        "alcoholConsumption",
        "physicalActivity",
        "sleepDuration"
      ],
      "health": [
        "chronicConditions",
        "familyHistory",
        "ayurvedicMedicine"
      ]
    }
  }
}