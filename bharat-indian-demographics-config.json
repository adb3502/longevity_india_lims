          ]
        },
        {
          "name": "familySize",
          "caption": "Number of Family Members in Household",
          "type": "INTEGER",
          "mandatory": true,
          "minValue": 1,
          "maxValue": 20,
          "note": "Total number of people living in the same household"
        },
        {
          "name": "maritalStatus",
          "caption": "Marital Status",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Single/Never married", "conceptCode": "SINGLE"},
            {"value": "Married", "conceptCode": "MARRIED"},
            {"value": "Divorced", "conceptCode": "DIVORCED"},
            {"value": "Separated", "conceptCode": "SEPARATED"},
            {"value": "Widowed", "conceptCode": "WIDOWED"},
            {"value": "Prefer not to say", "conceptCode": "PREFER_NOT_SAY"}
          ]
        },
        {
          "name": "healthInsurance",
          "caption": "Health Insurance Coverage",
          "type": "MULTISELECT",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Ayushman Bharat/PM-JAY", "conceptCode": "AYUSHMAN"},
            {"value": "ESIC", "conceptCode": "ESIC"},
            {"value": "CGHS", "conceptCode": "CGHS"},
            {"value": "Private Health Insurance", "conceptCode": "PRIVATE_INS"},
            {"value": "Employer Health Insurance", "conceptCode": "EMPLOYER_INS"},
            {"value": "State Government Health Insurance", "conceptCode": "STATE_INS"},
            {"value": "No Health Insurance", "conceptCode": "NO_INSURANCE"}
