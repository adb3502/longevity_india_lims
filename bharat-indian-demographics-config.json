        {
          "name": "ayurvedicMedicine",
          "caption": "Use of Ayurvedic/Traditional Medicine",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Never", "conceptCode": "NEVER"},
            {"value": "Rarely", "conceptCode": "RARELY"},
            {"value": "Sometimes", "conceptCode": "SOMETIMES"},
            {"value": "Regular use", "conceptCode": "REGULAR"},
            {"value": "Primary healthcare approach", "conceptCode": "PRIMARY"}
