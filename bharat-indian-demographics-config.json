        {
          "name": "motherTongue",
          "caption": "Mother Tongue",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Hindi", "conceptCode": "HI"},
            {"value": "Bengali", "conceptCode": "BN"},
            {"value": "Telugu", "conceptCode": "TE"},
            {"value": "Marathi", "conceptCode": "MR"},
            {"value": "Tamil", "conceptCode": "TA"},
            {"value": "Gujarati", "conceptCode": "GU"},
            {"value": "Urdu", "conceptCode": "UR"},
            {"value": "Kannada", "conceptCode": "KN"},
            {"value": "Odia", "conceptCode": "OR"},
            {"value": "Malayalam", "conceptCode": "ML"},
            {"value": "Punjabi", "conceptCode": "PA"},
            {"value": "Assamese", "conceptCode": "AS"},
            {"value": "Maithili", "conceptCode": "MAI"},
            {"value": "Sanskrit", "conceptCode": "SA"},
            {"value": "Nepali", "conceptCode": "NE"},
            {"value": "Konkani", "conceptCode": "KOK"},
            {"value": "Sindhi", "conceptCode": "SD"},
            {"value": "Dogri", "conceptCode": "DOI"},
            {"value": "Kashmiri", "conceptCode": "KS"},
            {"value": "Manipuri", "conceptCode": "MNI"},
            {"value": "Bodo", "conceptCode": "BRX"},
            {"value": "Santali", "conceptCode": "SAT"},
            {"value": "English", "conceptCode": "EN"},
            {"value": "Other", "conceptCode": "OTHER_LANG"}
          ]
        },
        {
          "name": "languagesSpoken",
          "caption": "Languages Spoken (Select all that apply)",
          "type": "MULTISELECT",
          "mandatory": true,
          "permissibleValues": "same_as_motherTongue",
          "note": "All languages the participant can speak fluently"
        },
        {
          "name": "dietaryPattern",
          "caption": "Dietary Pattern",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Vegetarian (Lacto-vegetarian)", "conceptCode": "LACTO_VEG"},
            {"value": "Vegetarian (Vegan)", "conceptCode": "VEGAN"},
            {"value": "Vegetarian (Jain)", "conceptCode": "JAIN_VEG"},
            {"value": "Non-vegetarian", "conceptCode": "NON_VEG"},
            {"value": "Pescatarian", "conceptCode": "PESCATARIAN"},
            {"value": "Eggetarian", "conceptCode": "EGGETARIAN"},
            {"value": "Flexitarian", "conceptCode": "FLEXITARIAN"}
          ]
        }
      ],
      
      "socioeconomicFactors": [
        {
          "name": "education",
          "caption": "Highest Level of Education",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "No formal education", "conceptCode": "NO_EDUCATION"},
            {"value": "Primary (1st-5th grade)", "conceptCode": "PRIMARY"},
            {"value": "Middle School (6th-8th grade)", "conceptCode": "MIDDLE"},
            {"value": "Secondary (9th-10th grade)", "conceptCode": "SECONDARY"},
            {"value": "Higher Secondary (11th-12th grade)", "conceptCode": "HIGHER_SEC"},
            {"value": "Diploma/Certificate", "conceptCode": "DIPLOMA"},
            {"value": "Graduate (Bachelor's degree)", "conceptCode": "GRADUATE"},
            {"value": "Post-graduate (Master's degree)", "conceptCode": "POST_GRAD"},
            {"value": "Professional degree (M.D., J.D., etc.)", "conceptCode": "PROFESSIONAL"},
            {"value": "Doctoral degree (Ph.D.)", "conceptCode": "DOCTORAL"}
