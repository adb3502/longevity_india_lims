        },
        {
          "name": "monthlyIncome",
          "caption": "Monthly Household Income (INR)",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Below ₹10,000", "conceptCode": "INCOME_1"},
            {"value": "₹10,000 - ₹25,000", "conceptCode": "INCOME_2"},
            {"value": "₹25,001 - ₹50,000", "conceptCode": "INCOME_3"},
