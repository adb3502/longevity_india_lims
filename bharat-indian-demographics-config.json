{
  "indianDemographics": {
    "name": "BHARAT Study Indian Population Demographics",
    "description": "Comprehensive demographic data collection tailored for Indian population in aging research",
    "version": "1.0",
    "dateCreated": "2025-01-24",
    
    "participantDemographics": {
      "basicInformation": [
        {
          "name": "firstName",
          "caption": "First Name",
          "type": "STRING",
          "mandatory": true,
          "maxLength": 50,
          "note": "Legal first name as per government ID"
        },
        {
          "name": "middleName",
          "caption": "Middle Name / Father's Name",
          "type": "STRING",
          "mandatory": false,
          "maxLength": 50,
          "note": "Middle name or father's name if applicable"
        },
        {
          "name": "lastName",
          "caption": "Last Name / Surname",
          "type": "STRING",
          "mandatory": true,
          "maxLength": 50,
          "note": "Family name or surname"
        },
        {
          "name": "localName",
          "caption": "Name in Local Language",
          "type": "STRING",
          "mandatory": false,
          "maxLength": 100,
          "note": "Name written in local script (Devanagari, Tamil, etc.)"
        },
        {
          "name": "gender",
          "caption": "Gender",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Male", "conceptCode": "MALE"},
            {"value": "Female", "conceptCode": "FEMALE"},
            {"value": "Other", "conceptCode": "OTHER"},
            {"value": "Prefer not to say", "conceptCode": "PREFER_NOT_SAY"}
          ]
        },
        {
          "name": "dateOfBirth",
          "caption": "Date of Birth",
          "type": "DATE",
          "mandatory": true,
          "maxDate": "current_date",
          "note": "Must be between 20-70 years for BHARAT Study"
        }
      ],
      
      "geographicInformation": [
        {
          "name": "birthState",
          "caption": "State of Birth",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Andhra Pradesh", "conceptCode": "AP"},
            {"value": "Arunachal Pradesh", "conceptCode": "AR"},
            {"value": "Assam", "conceptCode": "AS"},
            {"value": "Bihar", "conceptCode": "BR"},
            {"value": "Chhattisgarh", "conceptCode": "CG"},
            {"value": "Goa", "conceptCode": "GA"},
            {"value": "Gujarat", "conceptCode": "GJ"},
            {"value": "Haryana", "conceptCode": "HR"},
            {"value": "Himachal Pradesh", "conceptCode": "HP"},
            {"value": "Jharkhand", "conceptCode": "JH"},
            {"value": "Karnataka", "conceptCode": "KA"},
            {"value": "Kerala", "conceptCode": "KL"},
            {"value": "Madhya Pradesh", "conceptCode": "MP"},
            {"value": "Maharashtra", "conceptCode": "MH"},
            {"value": "Manipur", "conceptCode": "MN"},
            {"value": "Meghalaya", "conceptCode": "ML"},
            {"value": "Mizoram", "conceptCode": "MZ"},
            {"value": "Nagaland", "conceptCode": "NL"},
            {"value": "Odisha", "conceptCode": "OR"},
            {"value": "Punjab", "conceptCode": "PB"},
            {"value": "Rajasthan", "conceptCode": "RJ"},
            {"value": "Sikkim", "conceptCode": "SK"},
            {"value": "Tamil Nadu", "conceptCode": "TN"},
            {"value": "Telangana", "conceptCode": "TS"},
            {"value": "Tripura", "conceptCode": "TR"},
            {"value": "Uttar Pradesh", "conceptCode": "UP"},
            {"value": "Uttarakhand", "conceptCode": "UK"},
            {"value": "West Bengal", "conceptCode": "WB"},
            {"value": "Andaman and Nicobar Islands", "conceptCode": "AN"},
            {"value": "Chandigarh", "conceptCode": "CH"},
            {"value": "Dadra and Nagar Haveli and Daman and Diu", "conceptCode": "DH"},
            {"value": "Delhi", "conceptCode": "DL"},
            {"value": "Jammu and Kashmir", "conceptCode": "JK"},
            {"value": "Ladakh", "conceptCode": "LA"},
            {"value": "Lakshadweep", "conceptCode": "LD"},
            {"value": "Puducherry", "conceptCode": "PY"},
            {"value": "Outside India", "conceptCode": "FOREIGN"}
          ]
        },
        {
          "name": "currentState",
          "caption": "Current State of Residence",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": "same_as_birthState"
        },
        {
          "name": "currentDistrict",
          "caption": "Current District",
          "type": "STRING",
          "mandatory": true,
          "maxLength": 50,
          "note": "District of current residence"
        },
        {
          "name": "currentCity",
          "caption": "Current City/Town/Village",
          "type": "STRING",
          "mandatory": true,
          "maxLength": 50
        },
        {
          "name": "pinCode",
          "caption": "PIN Code",
          "type": "STRING",
          "mandatory": true,
          "pattern": "^[1-9][0-9]{5}$",
          "note": "6-digit Indian postal code"
        },
        {
          "name": "residenceType",
          "caption": "Type of Residence",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Urban", "conceptCode": "URBAN"},
            {"value": "Semi-Urban", "conceptCode": "SEMI_URBAN"},
            {"value": "Rural", "conceptCode": "RURAL"}
          ]
        },
        {
          "name": "yearsInCurrentLocation",
          "caption": "Years in Current Location",
          "type": "INTEGER",
          "mandatory": false,
          "minValue": 0,
          "maxValue": 100,
          "note": "Number of years living in current location"
        }
      ],
      
      "culturalBackground": [
        {
          "name": "religion",
          "caption": "Religion",
          "type": "DROPDOWN",
          "mandatory": false,
          "permissibleValues": [
            {"value": "Hinduism", "conceptCode": "HINDU"},
            {"value": "Islam", "conceptCode": "ISLAM"},
            {"value": "Christianity", "conceptCode": "CHRISTIAN"},
            {"value": "Sikhism", "conceptCode": "SIKH"},
            {"value": "Buddhism", "conceptCode": "BUDDHIST"},
            {"value": "Jainism", "conceptCode": "JAIN"},
            {"value": "Judaism", "conceptCode": "JEWISH"},
            {"value": "Zoroastrianism", "conceptCode": "ZOROASTRIAN"},
            {"value": "Other", "conceptCode": "OTHER_RELIGION"},
            {"value": "No Religion", "conceptCode": "NO_RELIGION"},
            {"value": "Prefer not to say", "conceptCode": "PREFER_NOT_SAY"}
