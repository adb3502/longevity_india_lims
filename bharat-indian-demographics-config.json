        },
        {
          "name": "occupation",
          "caption": "Current Occupation",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Student", "conceptCode": "STUDENT"},
            {"value": "Government Employee", "conceptCode": "GOVT_EMP"},
            {"value": "Private Employee", "conceptCode": "PRIVATE_EMP"},
            {"value": "Self-employed/Business", "conceptCode": "SELF_EMP"},
            {"value": "Farmer", "conceptCode": "FARMER"},
            {"value": "Agricultural Laborer", "conceptCode": "AGRI_LABOR"},
            {"value": "Daily wage laborer", "conceptCode": "DAILY_WAGE"},
            {"value": "Domestic worker", "conceptCode": "DOMESTIC"},
            {"value": "Homemaker", "conceptCode": "HOMEMAKER"},
            {"value": "Retired", "conceptCode": "RETIRED"},
            {"value": "Unemployed", "conceptCode": "UNEMPLOYED"},
            {"value": "Other", "conceptCode": "OTHER_OCC"}
