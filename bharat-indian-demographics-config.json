        },
        {
          "name": "caste",
          "caption": "Caste/Community (Optional)",
          "type": "DROPDOWN",
          "mandatory": false,
          "permissibleValues": [
            {"value": "General", "conceptCode": "GENERAL"},
            {"value": "Other Backward Class (OBC)", "conceptCode": "OBC"},
            {"value": "Scheduled Caste (SC)", "conceptCode": "SC"},
            {"value": "Scheduled Tribe (ST)", "conceptCode": "ST"},
