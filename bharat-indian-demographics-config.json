      "medicalHistory": [
        {
          "name": "chronicConditions",
          "caption": "Chronic Medical Conditions",
          "type": "MULTISELECT",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Diabetes (Type 1)", "conceptCode": "DIABETES_T1"},
            {"value": "Diabetes (Type 2)", "conceptCode": "DIABETES_T2"},
            {"value": "Hypertension", "conceptCode": "HYPERTENSION"},
            {"value": "Heart disease", "conceptCode": "HEART_DISEASE"},
            {"value": "Stroke", "conceptCode": "STROKE"},
            {"value": "Kidney disease", "conceptCode": "KIDNEY_DISEASE"},
            {"value": "Liver disease", "conceptCode": "LIVER_DISEASE"},
            {"value": "Cancer", "conceptCode": "CANCER"},
            {"value": "Arthritis", "conceptCode": "ARTHRITIS"},
            {"value": "Osteoporosis", "conceptCode": "OSTEOPOROSIS"},
            {"value": "Thyroid disorders", "conceptCode": "THYROID"},
            {"value": "Depression", "conceptCode": "DEPRESSION"},
            {"value": "Anxiety", "conceptCode": "ANXIETY"},
            {"value": "Asthma", "conceptCode": "ASTHMA"},
            {"value": "COPD", "conceptCode": "COPD"},
