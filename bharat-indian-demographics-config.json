        {
          "name": "familyHistory",
          "caption": "Family History of Diseases",
          "type": "MULTISELECT",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Diabetes", "conceptCode": "FAM_DIABETES"},
            {"value": "Heart disease", "conceptCode": "FAM_HEART"},
            {"value": "Cancer", "conceptCode": "FAM_CANCER"},
            {"value": "Stroke", "conceptCode": "FAM_STROKE"},
            {"value": "Hypertension", "conceptCode": "FAM_HTN"},
            {"value": "Alzheimer's/Dementia", "conceptCode": "FAM_ALZHEIMER"},
