          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Sedentary (little to no exercise)", "conceptCode": "SEDENTARY"},
            {"value": "Light activity (1-2 days/week)", "conceptCode": "LIGHT"},
            {"value": "Moderate activity (3-4 days/week)", "conceptCode": "MODERATE"},
            {"value": "High activity (5-6 days/week)", "conceptCode": "HIGH"},
            {"value": "Very high activity (daily)", "conceptCode": "VERY_HIGH"}
          ]
        },
        {
          "name": "yogaMeditation",
          "caption": "Yoga/Meditation Practice",
          "type": "DROPDOWN",
          "mandatory": true,
          "permissibleValues": [
            {"value": "Never", "conceptCode": "NEVER"},
            {"value": "Rarely (less than once a month)", "conceptCode": "RARELY"},
            {"value": "Sometimes (few times a month)", "conceptCode": "SOMETIMES"},
            {"value": "Regular (weekly)", "conceptCode": "WEEKLY"},
            {"value": "Daily", "conceptCode": "DAILY"}
          ]
        },
        {
          "name": "sleepDuration",
