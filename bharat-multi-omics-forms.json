{
  "multiOmicsForms": {
    "name": "BHARAT Study Multi-Omics Analysis Forms",
    "description": "Comprehensive forms for tracking genomics, proteomics, metabolomics, and epigenomics analysis in the BHARAT Study",
    "version": "1.0",
    "dateCreated": "2025-01-24",
    
    "forms": [
      {
        "name": "BHARAT_DNA_Extraction",
        "caption": "BHARAT Study DNA Extraction",
        "entityType": "SpecimenEvent",
        "multiRecord": true,
        "fields": [
          {
            "name": "sampleId",
            "caption": "Sample ID",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 50,
            "pattern": "^BHARAT-AG[1-5]-P\\d{4}-V[0-3]-[A-Z]{2,4}\\d{2}$"
          },
          {
            "name": "extractionDate",
            "caption": "Extraction Date",
            "type": "DATE",
            "mandatory": true,
            "maxDate": "current_date"
          },
          {
            "name": "extractionMethod",
            "caption": "Extraction Method",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "Qiagen DNeasy Blood & Tissue Kit", "conceptCode": "QIAGEN_DNEASY"},
              {"value": "Promega Wizard Genomic DNA Purification Kit", "conceptCode": "PROMEGA_WIZARD"},
              {"value": "ThermoFisher PureLink Genomic DNA Kit", "conceptCode": "THERMO_PURELINK"},
              {"value": "Manual Phenol-Chloroform", "conceptCode": "PHENOL_CHLOROFORM"},
              {"value": "Other", "conceptCode": "OTHER"}
            ]
          },
          {
            "name": "kitLotNumber",
            "caption": "Kit Lot Number",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 20,
            "pattern": "^[A-Z0-9-]+$"
          },
          {
            "name": "technicianId",
            "caption": "Technician",
            "type": "USER",
            "mandatory": true,
            "excludeType": "CONTACT"
          },
          {
            "name": "dnaYield",
            "caption": "DNA Yield (ng/μl)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 0,
            "maxValue": 5000
          },
          {
            "name": "extractedVolume",
            "caption": "Extracted Volume (μl)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 0,
            "maxValue": 200
          },
          {
            "name": "ratio260280",
            "caption": "260/280 Ratio",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 1.6,
            "maxValue": 2.1
          },
          {
            "name": "ratio260230",
            "caption": "260/230 Ratio",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 1.8,
            "maxValue": 2.4
          },
          {
            "name": "qcStatus",
            "caption": "QC Status",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "Pass", "conceptCode": "PASS"},
              {"value": "Fail", "conceptCode": "FAIL"},
              {"value": "Repeat", "conceptCode": "REPEAT"}
            ]
          },
          {
            "name": "storageLocation",
            "caption": "Storage Location",
            "type": "STRING",
            "mandatory": false,
            "maxLength": 100
          },
          {
            "name": "notes",
            "caption": "Notes",
            "type": "TEXT",
            "mandatory": false,
            "maxLength": 500
          }
        ]
      },
      
      {
        "name": "BHARAT_Genomics_Analysis",
        "caption": "BHARAT Study Genomics Analysis",
        "entityType": "SpecimenEvent",
        "multiRecord": true,
        "fields": [
          {
            "name": "sampleId",
            "caption": "Sample ID",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 50
          },
          {
            "name": "analysisDate",
            "caption": "Analysis Date",
            "type": "DATE",
            "mandatory": true
          },
          {
            "name": "sequencingPlatform",
            "caption": "Sequencing Platform",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "Illumina NovaSeq 6000", "conceptCode": "ILLUMINA_NOVASEQ"},
              {"value": "Illumina HiSeq X Ten", "conceptCode": "ILLUMINA_HISEQ"},
              {"value": "PacBio Sequel II", "conceptCode": "PACBIO_SEQUEL"},
              {"value": "Oxford Nanopore MinION", "conceptCode": "ONT_MINION"},
              {"value": "Oxford Nanopore PromethION", "conceptCode": "ONT_PROMETHION"}
            ]
          },
          {
            "name": "libraryPrepMethod",
            "caption": "Library Preparation Method",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "TruSeq DNA PCR-Free", "conceptCode": "TRUSEQ_PCRFREE"},
              {"value": "TruSeq DNA Nano", "conceptCode": "TRUSEQ_NANO"},
              {"value": "Nextera DNA Flex", "conceptCode": "NEXTERA_FLEX"},
              {"value": "SMRTbell Template Prep", "conceptCode": "SMRTBELL"},
              {"value": "Oxford Nanopore Ligation", "conceptCode": "ONT_LIGATION"}
            ]
          },
          {
            "name": "sequencingDepth",
            "caption": "Sequencing Depth (X coverage)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 1,
            "maxValue": 100
          },
          {
            "name": "readLength",
            "caption": "Read Length (bp)",
            "type": "INTEGER",
            "mandatory": true,
            "minValue": 50,
            "maxValue": 500
          },
          {
            "name": "q30Percentage",
            "caption": "Q30% Quality Score",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 70,
            "maxValue": 100
          },
          {
            "name": "totalReads",
            "caption": "Total Reads Generated (millions)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 1,
            "maxValue": 10000
          },
          {
            "name": "fastqFilePath",
            "caption": "FASTQ File Path",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 500
          },
          {
            "name": "bamFilePath",
            "caption": "BAM File Path",
            "type": "STRING",
            "mandatory": false,
            "maxLength": 500
          },
          {
            "name": "analysisPipelineVersion",
            "caption": "Analysis Pipeline Version",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 50
          },
          {
            "name": "referenceGenome",
            "caption": "Reference Genome",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "GRCh38/hg38", "conceptCode": "GRCH38"},
              {"value": "GRCh37/hg19", "conceptCode": "GRCH37"},
              {"value": "T2T-CHM13", "conceptCode": "T2T_CHM13"}
            ]
          }
        ]
      },
      
      {
        "name": "BHARAT_Proteomics_Analysis",
        "caption": "BHARAT Study Proteomics Analysis",
        "entityType": "SpecimenEvent",
        "multiRecord": true,
        "fields": [
          {
            "name": "sampleId",
            "caption": "Sample ID",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 50
          },
          {
            "name": "analysisDate",
            "caption": "Analysis Date",
            "type": "DATE",
            "mandatory": true
          },
          {
            "name": "msPlatform",
            "caption": "MS Platform",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "Thermo Orbitrap Fusion Lumos", "conceptCode": "THERMO_FUSION"},
              {"value": "Waters Synapt G2-Si", "conceptCode": "WATERS_SYNAPT"},
              {"value": "Agilent 6550 Q-TOF", "conceptCode": "AGILENT_QTOF"},
              {"value": "Bruker timsTOF Pro", "conceptCode": "BRUKER_TIMSTOF"},
              {"value": "Sciex TripleTOF 6600", "conceptCode": "SCIEX_TRIPLETOF"}
