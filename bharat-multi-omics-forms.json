          {
            "name": "uniquePeptides",
            "caption": "Unique Peptides Count",
            "type": "INTEGER",
            "mandatory": true,
            "minValue": 500,
            "maxValue": 100000
          },
          {
            "name": "searchDatabase",
            "caption": "Search Database",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "UniProt Human (SwissProt)", "conceptCode": "UNIPROT_SWISS"},
              {"value": "UniProt Human (TrEMBL)", "conceptCode": "UNIPROT_TREMBL"},
              {"value": "NCBI RefSeq Human", "conceptCode": "NCBI_REFSEQ"},
              {"value": "Ensembl Human", "conceptCode": "ENSEMBL"}
            ]
          },
          {
            "name": "fdrThreshold",
            "caption": "FDR Threshold (%)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 0.1,
            "maxValue": 5.0,
            "defaultValue": 1.0
          },
          {
            "name": "rawFileLocation",
            "caption": "Raw File Location",
            "type": "STRING",
            "mandatory": true,
            "maxLength": 500
          },
          {
            "name": "searchEngine",
            "caption": "Search Engine",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "MaxQuant", "conceptCode": "MAXQUANT"},
              {"value": "Proteome Discoverer", "conceptCode": "PD"},
              {"value": "Sequest", "conceptCode": "SEQUEST"},
              {"value": "Mascot", "conceptCode": "MASCOT"},
              {"value": "X!Tandem", "conceptCode": "XTANDEM"}
            ]
          }
        ]
      },
      
