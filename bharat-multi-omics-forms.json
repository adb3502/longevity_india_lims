          },
          {
            "name": "samplePrepMethod",
            "caption": "Sample Preparation Method",
            "type": "DROPDOWN",
            "mandatory": true,
            "permissibleValues": [
              {"value": "In-solution trypsin digestion", "conceptCode": "INSOL_TRYPSIN"},
              {"value": "Filter-aided sample preparation (FASP)", "conceptCode": "FASP"},
              {"value": "Single-pot solid-phase-enhanced sample preparation (SP3)", "conceptCode": "SP3"},
              {"value": "Suspension trapping (S-Trap)", "conceptCode": "STRAP"},
              {"value": "TMT labeling", "conceptCode": "TMT"}
            ]
          },
          {
            "name": "proteinConcentration",
            "caption": "Protein Concentration (μg/μl)",
            "type": "FLOAT",
            "mandatory": true,
            "minValue": 0.1,
            "maxValue": 100
          },
          {
            "name": "proteinsIdentified",
            "caption": "Number of Proteins Identified",
            "type": "INTEGER",
            "mandatory": true,
            "minValue": 100,
            "maxValue": 20000
